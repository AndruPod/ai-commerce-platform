# PostgreSQL (docker compose maps container 5432 -> host POSTGRES_PORT)
POSTGRES_USER=vsa
POSTGRES_PASSWORD=vsa
POSTGRES_DB=vsa_commerce
POSTGRES_PORT=5434

DATABASE_URL=postgres://vsa:vsa@localhost:5434/vsa_commerce

# HTTP port for the NestJS API
PORT=3001
# Comma-separated browser origins allowed to call the API (the Next.js demo frontend)
CORS_ORIGINS=http://localhost:3002

# --- AI layer (optional; /ai/chat returns 503 when OPENAI_API_KEY is empty) ---
OPENAI_API_KEY=
# Leave empty to use the default defined in src/ai/ai.config.ts
OPENAI_MODEL=
# Max model<->tool round trips per chat request (1-10, default 6)
AI_MAX_TOOL_ITERATIONS=6
